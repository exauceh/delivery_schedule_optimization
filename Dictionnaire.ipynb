    "CAMION_KG, CAMION_M3 = 24_500, 110.4\n",
    "FERIES = pd.to_datetime([\"2026-11-11\"])\n",
    "\n",
    "def cout_envoi(km, kg):\n",
    "    i, j = np.searchsorted(KM, km), np.searchsorted(KG, kg)  # plus petite borne >= valeur\n",
    "    return grille.iat[i, j] * (1 + marge) * diesel\n",
    "\n",
    "b = besoins.copy()\n",
    "b[\"date_livraison\"] = b[\"date\"].where(~b[\"date\"].isin(FERIES), b[\"date\"] - pd.offsets.BDay(1))\n",
    "b = b.merge(distances, on=\"supplier_id\", how=\"left\")\n",
    "\n",
    "livraisons = (b.groupby([\"supplier_id\", \"plant\", \"date_livraison\"])\n",
    "                .agg(lignes=(\"material\", \"size\"), poids_kg=(\"weight\", \"sum\"),\n",
    "                     volume_m3=(\"volume\", \"sum\"), distance_km=(\"distance\", \"first\"))\n",
    "                .reset_index())\n",
    "livraisons[\"camions\"] = np.ceil(np.maximum(livraisons[\"poids_kg\"] / CAMION_KG,\n",
    "                                           livraisons[\"volume_m3\"] / CAMION_M3)).clip(lower=1).astype(int)\n",
    "livraisons[\"remplissage_poids\"] = livraisons[\"poids_kg\"] / (livraisons[\"camions\"] * CAMION_KG)\n",
    "livraisons[\"cout_eur\"] = [c * cout_envoi(km, kg / c) if pd.notna(km) else np.nan for c, km, kg in\n",
    "                          zip(livraisons[\"camions\"], livraisons[\"distance_km\"], livraisons[\"poids_kg\"])]\n",
    "\n",
    "# Preuve des formules : l'exemple du cadrage (SUP_00085 -> PLT_004, semaine du 16/11) donne 1 215 €\n",
    "ex = livraisons[(livraisons[\"supplier_id\"] == \"SUP_00085\") & (livraisons[\"plant\"] == \"PLT_004\")\n",
    "                & livraisons[\"date_livraison\"].between(\"2026-11-16\", \"2026-11-20\")]\n",
    "print(f\"Total : {len(ex)} livraisons, {ex['poids_kg'].sum():,.0f} kg, {ex['cout_eur'].sum():,.2f} € (cadrage : 1 215 €)\")\n",
    "ex.round({\"remplissage_poids\": 3, \"cout_eur\": 2})"
   ]
