   "source": [
    "def ajuster(g):\n",
    "    q = g.groupby(\"schedule_quantity\")[\"weight\"].median()            # poids médian par quantité\n",
    "    pente, fixe = np.polyfit(q.index.to_numpy(), q.to_numpy(), 1)   # poids = fixe + pente x quantité\n",
    "    u = q.to_numpy() / q.index.to_numpy()\n",
    "    return pd.Series({\"quantites\": len(q), \"proportionnel\": u.max() / u.min() < 1.01,\n",
    "                      \"qte_min\": q.index.min(), \"qte_max\": q.index.max(),\n",
    "                      \"poids_min_kg\": q.min(), \"poids_max_kg\": q.max(),\n",
    "                      \"part_fixe_kg\": fixe, \"poids_par_piece_kg\": pente})\n",
    "\n",
    "avec_poids = besoins.dropna(subset=[\"weight\"])\n",
    "testables = avec_poids.groupby([\"material\", \"plant\"]).filter(lambda g: g[\"schedule_quantity\"].nunique() >= 2)\n",
    "modele = testables.groupby([\"material\", \"plant\"]).apply(ajuster, include_groups=False)\n",
    "atypiques = modele[~modele[\"proportionnel\"].astype(bool) & (modele[\"part_fixe_kg\"] <= 0)].drop(columns=\"proportionnel\")\n",
    "\n",
    "print(f\"Cas atypiques : {len(atypiques)} ; dont seulement 2 quantités observées : \"\n",
    "      f\"{int((atypiques['quantites'] == 2).sum())} ; par usine : {atypiques.index.get_level_values('plant').value_counts().to_dict()}\")\n",
    "atypiques.round(3)"
   ]
  },
