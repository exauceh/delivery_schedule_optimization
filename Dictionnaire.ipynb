   "source": [
    "definitions = pd.DataFrame([\n",
    "    (\"date\", \"jour\", \"Jour où la pièce doit être à l'usine\", \"Jamais le week-end. 11/11 férié : livré avant\"),\n",
    "    (\"supplier_id\", \"–\", \"Fournisseur\", \"Clé vers distances.csv\"),\n",
    "    (\"material\", \"–\", \"Référence de la pièce\", \"Parfois livrée à plusieurs usines\"),\n",
    "    (\"plant\", \"–\", \"Usine de destination\", \"Fournisseur × usine = couple, unité de consolidation\"),\n",
    "    (\"unloading_point\", \"–\", \"Quai de déchargement\", \"1 quai = 1 usine ; plusieurs quais par camion (confirmé)\"),\n",
    "    (\"schedule_quantity\", \"pièces\", \"Pièces à livrer\", \"Entiers ; 0 = pas de besoin (qualité §1)\"),\n",
    "    (\"weight\", \"kg\", \"Poids de la ligne, emballage compris (confirmé)\", \"Chaque ligne a son propre emballage : part fixe + poids par pièce (qualité §4) ; manquants (qualité §5)\"),\n",
    "    (\"volume\", \"m³\", \"Volume du conteneur de la ligne (confirmé)\", \"Fixe par article × quai, indépendant de la quantité (3.2.1)\"),\n",
    "    (\"transmission_date\", \"jour\", \"Date d'envoi du programme au fournisseur (définition du cadrage)\", \"Non utilisée\"),\n",
    "    (\"version_date\", \"jour\", \"Version du programme\", \"Une seule version ; non utilisée\"),\n",
    "], columns=[\"colonne\", \"unité\", \"description\", \"remarque\"]).set_index(\"colonne\")\n",
    "\n",
    "stats = pd.DataFrame({\n",
    "    \"manquants (toutes lignes)\": schedule.isna().sum(),\n",
    "    \"manquants (besoins)\": besoins.isna().sum(),\n",
    "    \"distinctes\": besoins.nunique(),\n",
    "    \"min\": besoins.min(numeric_only=False),\n",
    "    \"max\": besoins.max(numeric_only=False),\n",
    "})\n",
    "for c in [\"min\", \"max\"]:\n",
    "    stats[c] = stats[c].map(lambda v: f\"{v:%d/%m/%Y}\" if isinstance(v, pd.Timestamp) else v)\n",
    "definitions.join(stats)"
   ]
