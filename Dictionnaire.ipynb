    "def a_un_bom(chemin):\n",
    "    with open(chemin, \"rb\") as f:\n",
    "        return f.read(3) == b\"\\xef\\xbb\\xbf\"\n",
    "\n",
    "pd.DataFrame({\n",
    "    \"released_schedule.csv\": [len(schedule), schedule.shape[1], a_un_bom(SCHEDULE),\n",
    "                              f\"{besoins['date'].min():%d/%m/%Y} → {besoins['date'].max():%d/%m/%Y}\"],\n",
    "    \"distances.csv\": [len(distances), distances.shape[1], a_un_bom(DISTANCES), \"non datée\"],\n",
    "}, index=[\"lignes\", \"colonnes\", \"BOM\", \"période des besoins\"])"
   ]
  },
