   "source": [
    "with pdfplumber.open(RATES) as pdf:\n",
    "    texte = \"\\n\".join(page.extract_text() for page in pdf.pages)\n",
    "\n",
    "lignes = [l.split() for l in texte.splitlines() if re.fullmatch(r\">?\\d+( \\d+\\.\\d+){15}\", l.strip())]\n",
    "kg = [50, 100, 200, 300, 400, 500, 750, 1000, 1500, 2000, 2500, 3000, 3500, 4000, \">4000\"]\n",
    "grille = pd.DataFrame([[float(x) for x in l[1:]] for l in lignes], index=[l[0] for l in lignes], columns=kg)\n",
    "marge = float(re.search(r\"margin:\\s*([\\d.]+)\", texte).group(1)) / 100\n",
    "diesel = float(re.search(r\"Diesel surcharge:\\s*([\\d.]+)\", texte).group(1))\n",
    "validite = re.search(r\"Valid from:\\s*([\\d.]+)\", texte).group(1)\n",
    "\n",
    "pd.DataFrame([\n",
    "    (\"ligne\", \"km\", \"Tranche de distance, borne haute incluse (47 km → ligne 50)\", f\"{len(grille)} tranches, de 30 à >650\"),\n",
    "    (\"colonne\", \"kg\", \"Tranche de poids d'un camion, borne haute incluse (316 kg → colonne 400)\", f\"{grille.shape[1]} tranches, de 50 à >4000\"),\n",
    "    (\"case\", \"EUR\", \"Coût de base d'un envoi\", f\"{grille.values.min()} à {grille.values.max()}\"),\n",
    "    (\"marge\", \"%\", \"Marge appliquée au coût de base\", f\"{marge:.2%}\"),\n",
    "    (\"diesel\", \"facteur\", \"Surcharge carburant\", diesel),\n",
    "    (\"validité\", \"date\", \"Date d'entrée en vigueur\", validite),\n",
    "], columns=[\"élément\", \"unité\", \"description\", \"valeur\"]).set_index(\"élément\")"
   ]
  },
