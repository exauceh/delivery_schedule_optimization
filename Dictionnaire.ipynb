    "import matplotlib.pyplot as plt\n",
    "from matplotlib.patches import FancyBboxPatch\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(16, 5.4))\n",
    "ax.set_xlim(0, 16.2); ax.set_ylim(0, 5.4); ax.axis(\"off\")\n",
    "X = [0.1, 3.5, 6.9, 10.3, 13.7]\n",
    "Y = {\"haut\": 3.9, \"milieu\": 2.2, \"bas\": 0.5}\n",
    "W, H = 2.1, 0.95\n",
    "\n",
    "def boite(col, ligne, texte, couleur, w=W):\n",
    "    ax.add_patch(FancyBboxPatch((X[col], Y[ligne]), w, H, boxstyle=\"round,pad=0.04\", fc=couleur, ec=\"#555\", lw=1))\n",
    "    ax.text(X[col] + w / 2, Y[ligne] + H / 2, texte, ha=\"center\", va=\"center\", fontsize=9)\n",
    "\n",
    "def fleche(x1, y1, x2, y2, texte=\"\", dx=0, dy=0.15):\n",
    "    ax.annotate(\"\", (x2, y2), (x1, y1), arrowprops=dict(arrowstyle=\"->\", color=\"#555\", lw=1.2))\n",
    "    if texte:\n",
    "        ax.text((x1 + x2) / 2 + dx, (y1 + y2) / 2 + dy, texte, ha=\"center\", fontsize=8, color=\"#333\")\n",
    "\n",
    "SRC, ETAPE, SORTIE = \"#dbe7f6\", \"#eeeeea\", \"#d8efe2\"\n",
    "boite(0, \"haut\", \"released_schedule.csv\\nbesoins par jour\", SRC)\n",
    "boite(0, \"milieu\", \"distances.csv\\nkm par fournisseur\", SRC)\n",
    "boite(0, \"bas\", \"rate_sheet.pdf\\ngrille km × kg\", SRC)\n",
    "boite(1, \"haut\", \"Besoins préparés\\nquantité > 0,\\n11/11 avancé\", ETAPE)\n",
    "boite(2, \"haut\", \"Couples\\nfournisseur × usine\", ETAPE)\n",
    "boite(2, \"milieu\", \"Profil par couple\\nfréquence + jours\", ETAPE)\n",
    "boite(3, \"milieu\", \"Camions\\n≤ 24,5 t et 110,4 m³\", ETAPE)\n",
    "boite(3, \"bas\", \"Coût par camion\\nligne km, colonne kg\", ETAPE)\n",
    "boite(4, \"haut\", \"Sortie 1\\nprofil par couple\", SORTIE, w=2.3)\n",
    "boite(4, \"milieu\", \"Sortie 2\\narticles par camion\", SORTIE, w=2.3)\n",
    "boite(4, \"bas\", \"Sortie 3\\néconomie avant / après\", SORTIE, w=2.3)\n",
    "\n",
    "milieu = lambda l: Y[l] + H / 2\n",
    "fleche(X[0] + W, milieu(\"haut\"), X[1] - 0.05, milieu(\"haut\"), \"nettoyage\")\n",
    "fleche(X[1] + W, milieu(\"haut\"), X[2] - 0.05, milieu(\"haut\"), \"supplier_id\\n+ plant\", dy=0.08)\n",
    "fleche(X[2] + W / 2, Y[\"haut\"] - 0.05, X[2] + W / 2, Y[\"milieu\"] + H + 0.05)\n",
    "fleche(X[2] + W, milieu(\"milieu\"), X[3] - 0.05, milieu(\"milieu\"), \"regroupement\")\n",
    "fleche(X[2] + W, Y[\"milieu\"] + H, X[4] - 0.05, milieu(\"haut\"))\n",
    "fleche(X[3] + W, milieu(\"milieu\"), X[4] - 0.05, milieu(\"milieu\"))\n",
    "fleche(X[3] + W / 2, Y[\"milieu\"] - 0.05, X[3] + W / 2, Y[\"bas\"] + H + 0.05, \"poids\", dx=0.35, dy=0)\n",
    "fleche(X[0] + W, milieu(\"milieu\") - 0.2, X[3] - 0.05, milieu(\"bas\") + 0.2, \"km (supplier_id)\", dx=-1.6, dy=0.45)\n",
    "fleche(X[0] + W, milieu(\"bas\"), X[3] - 0.05, milieu(\"bas\"), \"grille\", dx=-2.6)\n",
    "fleche(X[3] + W, milieu(\"bas\"), X[4] - 0.05, milieu(\"bas\"))\n",
    "for col, titre, couleur in [(0, \"Sources\", \"#2a5d9f\"), (1, \"Préparation et moteur\", \"#555\"), (4, \"Sorties attendues\", \"#2b7a4b\")]:\n",
    "    ax.text(X[col], 5.1, titre, fontsize=10, weight=\"bold\", color=couleur)\n",
    "plt.show()"
   ]
