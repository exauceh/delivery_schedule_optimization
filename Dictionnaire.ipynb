    "# Dépendances : pandas, numpy, matplotlib, pdfplumber (pip install pdfplumber, pour lire la grille en 3.4)\n",
    "from pathlib import Path\n",
    "import re\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import pdfplumber\n",
    "\n",
    "pd.set_option(\"display.max_colwidth\", None)\n",
    "DATA_DIR = Path(\"data\")  # à adapter\n",
    "SCHEDULE, DISTANCES, RATES = DATA_DIR / \"released_schedule.csv\", DATA_DIR / \"distances.csv\", DATA_DIR / \"rate_sheet.pdf\"\n",
    "\n",
    "# Les CSV commencent par un BOM : \"utf-8-sig\" le retire.\n",
    "schedule = pd.read_csv(SCHEDULE, encoding=\"utf-8-sig\", parse_dates=[\"date\", \"transmission_date\", \"version_date\"])\n",
    "schedule = schedule[schedule[\"date\"] < \"2027-01-01\"]  # 01/01/2027 écarté (usine fermée fin décembre, qualité §3.2)\n",
    "distances = pd.read_csv(DISTANCES, encoding=\"utf-8-sig\")\n",
    "besoins = schedule[schedule[\"schedule_quantity\"] > 0]  # besoins réels (qualité §1)\n",
    "CLE_SCHEDULE = [\"date\", \"supplier_id\", \"material\", \"plant\", \"unloading_point\"]"
   ]
  },
