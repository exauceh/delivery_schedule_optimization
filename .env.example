# Settings of the application (prefix DSO_). Every value has a default: no secret is needed.
# `uv run main.py ...` copies this file to .env on first use; edit .env, never this file.

# Folder of the runs: one sub-folder per run with its inputs, outputs, manifest and log
DSO_RUNS_DIR=runs
DSO_LOG_LEVEL=INFO

# Processes for the candidate plans (default: every CPU core). Set it in a container with a CPU limit.
# DSO_WORKERS=4

# API
DSO_HOST=127.0.0.1
DSO_PORT=8000
DSO_MAX_UPLOAD_MB=50
